+void
+backtrace(void)
+{
+    uint64 fp = r_fp();  // current frame pointer
+    printf("backtrace:\n");
+
+    // find stack boundaries
+    uint64 stack_top = PGROUNDUP(fp);
+    uint64 stack_bottom = PGROUNDDOWN(fp);
+
+    while (fp >= stack_bottom && fp < stack_top) {
+        uint64 ra = *((uint64 *)(fp - 8));  // return address is at fp - 8
+        printf("%p\n", ra);
+
+        uint64 next_fp = *((uint64 *)(fp - 16));  // saved previous frame pointer is at fp - 16
+        if (next_fp == 0 || next_fp <= fp)  // invalid next frame
+            break;
+        fp = next_fp;
+    }
+}
