+uint64 sys_sigalarm(void)
+{
+  int ticks;
+  uint64 handler;
+  if (argint(0, &ticks) < 0 || argaddr(1, &handler) < 0)
+    return -1;
+
+  struct proc *p = myproc();
+
+  acquire(&p->lock);
+
+  if (ticks == 0) {
+    p->alarm_handler = 0;
+    p->alarm_ticks = 0;
+    p->alarm_ticks_max = 0;
+    p->alarm_state = INACTIVE;
+  } else {
+    p->alarm_handler = handler;
+    p->alarm_ticks = ticks;
+    p->alarm_ticks_max = ticks;
+    p->alarm_state = ACTIVE;
+  }
+
+  release(&p->lock);
+
+  return 0;  // Success
+}
+
+uint64 sys_sigreturn(void)
+{
+    struct proc *p = myproc();
+
+    acquire(&p->lock);
+    if (p->backup_tf != 0) {
+        memmove(p->trapframe, p->backup_tf, sizeof(struct trapframe));
+    }
+
+    p->alarm_state = ACTIVE;
+
+    release(&p->lock);
+
+    return 0;
+}
